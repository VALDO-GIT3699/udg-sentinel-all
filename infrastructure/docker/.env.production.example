# ============================================================
# UDG Sentinel — Variables de entorno de PRODUCCIÓN (plantilla)
# ============================================================
# Copiar a ".env.production" en este mismo directorio (junto a
# docker-compose.prod.yml) y llenar los valores reales. Ese archivo NUNCA
# debe subirse a git (agregar ".env.production" a .gitignore si no está ya).
#
# docker-compose.prod.yml carga este archivo con "env_file:" para los
# servicios app/horizon/scheduler.
# ============================================================

APP_NAME="UDG Sentinel"
APP_ENV=production
APP_KEY=
# Generar con: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://udgsentinel.udg.mx
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ──────────────────────────────────────────────
# BASE DE DATOS — PostgreSQL (mismos valores que
# db.environment en docker-compose.prod.yml)
# ──────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=udg_sentinel
DB_USERNAME=sentinel_prod
DB_PASSWORD=

# ──────────────────────────────────────────────
# SESIONES — secure cookie es OBLIGATORIO en
# producción: sin esto, la cookie de sesión viaja
# sin la bandera Secure y un downgrade a HTTP (o
# un proxy mal configurado) podría filtrarla.
# ──────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_PREFIX=sentinel_
QUEUE_CONNECTION=redis

# ──────────────────────────────────────────────
# REDIS (mismo REDIS_PASSWORD que
# redis.command en docker-compose.prod.yml)
# ──────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.udg.mx
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="sentinel@udg.mx"
MAIL_FROM_NAME="${APP_NAME}"

HORIZON_ENABLED=true

# ──────────────────────────────────────────────
# RESPALDOS (monitoring:backup-database,
# programado diario 02:30 hora Guadalajara)
# ──────────────────────────────────────────────
BACKUP_KEEP_DAYS=14
# Opcional: nombre de un disco extra de config/filesystems.php (p. ej. "s3")
# para copiar cada respaldo FUERA de este servidor. Sin esto, los respaldos
# solo viven en storage/app/backups de este mismo host -si el disco del
# servidor falla, se pierden junto con la base de datos-.
BACKUP_OFFSITE_DISK=

# ──────────────────────────────────────────────
# SEGURIDAD
# ──────────────────────────────────────────────
AUTH_MAX_LOGIN_ATTEMPTS=10
AUTH_LOCKOUT_MINUTES=60
SECURITY_HEADERS_ENABLE_CSP=true
# Dejar VACÍO en producción: el autologin local (Modules/Monitoring/routes/web.php)
# ya se auto-bloquea con abort_unless(app()->environment('local')), pero
# nunca debe existir un token real fuera de entornos de desarrollo.
MONITORING_LOCAL_AUTOLOGIN_TOKEN=
MONITORING_LOGIN_DEFAULT_USER=udgmonitoreo26B

# Desactivado en producción: Telescope expone datos internos de cada
# request (queries, jobs, variables de entorno) y no debe correr fuera de
# desarrollo.
TELESCOPE_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================
# Checklist antes del primer "docker compose up" en el servidor real:
#   [ ] APP_KEY generado y copiado aquí (nunca reutilizar el de desarrollo)
#   [ ] DB_PASSWORD / REDIS_PASSWORD generados aleatorios (32+ caracteres)
#   [ ] Certificado TLS institucional en /etc/ssl/sentinel/ (fullchain.pem, privkey.pem)
#   [ ] MONITORING_LOCAL_AUTOLOGIN_TOKEN vacío
#   [ ] Cuenta admin real creada desde /monitoring/admin/users (no reutilizar
#       ninguna cuenta ni contraseña usada en desarrollo)
#   [ ] Verificar "docker compose exec app php artisan schedule:list" muestra
#       monitoring:backup-database corriendo diario
# ============================================================
